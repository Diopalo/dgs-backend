generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYSTE
  REDACTEUR
}

enum Priorite {
  HAUTE
  MOYENNE
  BASSE
}

enum TypeReco {
  TECHNIQUE
  CONTENU
  MOTS_CLES
}

enum StatutReco {
  OUVERTE
  EN_COURS
  RESOLUE
}

enum StatutContenu {
  IDEE
  REDACTION
  PUBLIE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(REDACTEUR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projets   Projet[]
}

model Projet {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId Int
  user   User  @relation(fields: [userId], references: [id])

  sites  Site[]
}

model Site {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projetId Int
  projet   Projet @relation(fields: [projetId], references: [id])

  keywords         Keyword[]
  auditResults     AuditResult[]
  recommandations  Recommandation[]
  contenus         ContenuEditorial[]
}

model Keyword {
  id            Int      @id @default(autoincrement())
  expression    String
  categorie     String?
  volume_estime Int?
  priorite      Priorite @default(MOYENNE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  siteId Int
  site   Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  positionnements Positionnement[]
  recommandations Recommandation[]
}

model AuditResult {
  id                 Int      @id @default(autoincrement())
  score              Int
  statut             String   @default("en_cours")
  vitesse_ms         Int?
  balises_manquantes String?
  liens_morts        String?
  details            String?
  crawledAt          DateTime @default(now())

  siteId Int
  site   Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  recommandations Recommandation[]
}

model Positionnement {
  id          Int      @id @default(autoincrement())
  position    Int?
  url_trouvee String?
  mesuredAt   DateTime @default(now())

  keywordId Int
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
}

model Recommandation {
  id        Int        @id @default(autoincrement())
  siteId    Int
  auditId   Int?
  keywordId Int?
  type      TypeReco
  priorite  Priorite
  message   String
  statut    StatutReco @default(OUVERTE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  site    Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  audit   AuditResult? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  keyword Keyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  contenus ContenuEditorial[]
}

model ContenuEditorial {
  id               Int           @id @default(autoincrement())
  titre            String
  statut           StatutContenu @default(IDEE)
  date_publication DateTime?
  assigneA         String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  siteId           Int
  site             Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)

  recommandationId Int?
  recommandation   Recommandation? @relation(fields: [recommandationId], references: [id], onDelete: SetNull)
}
