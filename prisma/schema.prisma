generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  ANALYSTE
  REDACTEUR
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(REDACTEUR) //REDACTEUR : Il représente le rôle par défaut 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projets   Projet[]
}

model Projet {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  sites       Site[]
}

model Site {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projetId  Int
  projet    Projet   @relation(fields: [projetId], references: [id])

  keywords     Keyword[]
  auditResults AuditResult[]
}

model Keyword {
  id               Int      @id @default(autoincrement())
  motCle           String
  urlCible         String?
  volumeRecherche  Int?
  categorie        String?
  priorite         Priorite @default(MOYENNE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  siteId           Int
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  positions        Positionnement[]
}

model Positionnement {
  id         Int      @id @default(autoincrement())
  position   Int
  dateMesure DateTime @default(now())
  keywordId  Int
  keyword    Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, dateMesure])
}

model AuditResult {
  id        Int      @id @default(autoincrement())
  score     Int
  details   String?
  crawledAt DateTime @default(now())

  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id])
}
