# ─── Serveur ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_in_production_min_32_chars_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── SerpAPI ──────────────────────────────────────────────────────────────────
SERPAPI_KEY=
SERPAPI_COUNTRY=sn
SERPAPI_LANG=fr

# ─── Crawler Python ───────────────────────────────────────────────────────────
PYTHON_EXECUTABLE=python
CRAWLER_MAX_PAGES=500
CRAWLER_DELAY_MS=500
CRAWLER_MAX_WORKERS=5
CRAWLER_TIMEOUT_MS=600000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=100
RATE_LIMIT_AUDIT_MAX=5

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
